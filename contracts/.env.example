# Copy to contracts/.env (git-ignored) and fill in. Never commit real keys.

# RPC endpoints, referenced from foundry.toml [rpc_endpoints]
SEPOLIA_RPC_URL=
ETC_RPC_URL=https://etc.rivet.link

# No private key here. Import the deployer once into Foundry's encrypted
# keystore and deploy with `--account deployer`:
#   cast wallet import deployer --interactive

# Optional, applied in the deploy broadcast by script/Chainvoice.s.sol
TREASURY_ADDRESS=
# Native fee per paid invoice, in wei. Leave blank for the default 0.0005 ether.
FEE_WEI=

# Contract verification on Sepolia (Etherscan). ETC verifies on Blockscout, no key needed.
ETHERSCAN_API_KEY=
