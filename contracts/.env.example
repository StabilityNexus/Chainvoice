# Copy to contracts/.env (git-ignored) and fill in. Never commit real keys.

# RPC endpoints, referenced from foundry.toml [rpc_endpoints]
SEPOLIA_RPC_URL=
ETC_RPC_URL=https://etc.etcdesktop.com

# No private key here. Import the deployer once into Foundry's encrypted
# keystore and deploy with `--account deployer`:
#   cast wallet import deployer --interactive

# Required, set at deploy time by script/Chainvoice.s.sol.
# DEV_ADDRESS sets the dev fee and the fee receiver and can hand its role over in
# two steps (use a multisig). DEV_FEE_RECEIVER receives withdrawn fees.
DEV_ADDRESS=
DEV_FEE_RECEIVER=
# Optional. Native fee per paid invoice, in wei, must not be 0. Leave blank for the default 0.0005 ether.
DEV_FEE_WEI=

# Contract verification on Sepolia (Etherscan). ETC verifies on Blockscout, no key needed.
ETHERSCAN_API_KEY=
